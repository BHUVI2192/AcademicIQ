# ============================================
# AcademeIQ Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- Supabase (Required) ---
# Get these from your Supabase project: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-side only (NEVER expose to client) ---
# Used for Edge Functions and admin scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Email Notifications (Required for send-notification Edge Function) ---
# Get from https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# --- Application Config ---
VITE_APP_NAME=AcademeIQ
VITE_APP_URL=http://localhost:5173
